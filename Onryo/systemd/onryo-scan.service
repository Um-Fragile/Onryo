[Unit]
Description=Onryo Scanner – one-shot directory scan and DB sync
After=network-online.target
Before=onryo-core.service

[Service]
Type=oneshot
User=onryo
Group=onryo
WorkingDirectory=/opt/onryo
ExecStart=/opt/onryo/venv/bin/python -m backend.scanner.scanner
StandardOutput=append:/var/log/onryo/scanner.log
StandardError=append:/var/log/onryo/scanner.log
Environment=ONRYO_DB=/opt/onryo/onryo.db
Environment=ONRYO_DIRS_CONFIG=/etc/onryo/directories.json

[Install]
WantedBy=multi-user.target
