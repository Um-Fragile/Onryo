# Onryo udev rule – input lockout support
# This file is written by the installer and managed by onryo-input-guard.
# DO NOT hand-edit; run 'onryo-input-guard' reconfigure or re-run install.sh.

# When the input guard is active (no display connected), tag all keyboard/mouse
# devices so the guard daemon can reference them by tag.
# Actual grab/release is done in software (evdev EVIOCGRAB) by input_guard.py;
# this rule just adds a persistent tag so the daemon can enumerate them cleanly.

ACTION=="add", SUBSYSTEM=="input", \
  ENV{ID_INPUT_KEYBOARD}=="1", \
  TAG+="onryo_input_keyboard"

ACTION=="add", SUBSYSTEM=="input", \
  ENV{ID_INPUT_MOUSE}=="1", \
  TAG+="onryo_input_mouse"

ACTION=="add", SUBSYSTEM=="input", \
  ENV{ID_INPUT_TOUCHPAD}=="1", \
  TAG+="onryo_input_touchpad"

# DRM connector hotplug – triggers input_guard.py to re-evaluate lockout state
ACTION=="change", SUBSYSTEM=="drm", \
  RUN+="/usr/bin/systemctl --no-block kill -s SIGUSR1 onryo-input-guard.service"
